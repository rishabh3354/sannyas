<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: an open enso around a play triangle.

  This deliberately replaces the previous "OSHO" wordmark. That mark was the
  trademark itself, which an independent player has no licence to use as its
  own logo — and a launcher icon is the most conspicuous place to be using one.
  A symbol also survives the store listing better than a word: the launcher
  gives a wordmark about nine device-independent pixels of height, whereas a
  two-element symbol stays legible all the way down to the notification tray.

  The enso is left open at the upper right, as a brush-drawn one always is. The
  gap has to stay wider than the stroke or it reads as a closed ring at small
  sizes, which is a different symbol entirely.

  Monoline strokes with round caps, matching the design system. Everything sits
  inside the 66dp adaptive safe zone — the enso's outer edge reaches 29.5dp
  from centre against the 33dp the mask guarantees — so no launcher mask can
  clip it. Both paths are stroked with no fill, which is also what
  branding/render_icon.py assumes when it rasterises the store asset.

  Doubles as the monochrome layer for themed icons: it carries no background of
  its own, so the system can tint it whole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M58.69,27.41 A27,27 0 1,0 74.68,36.64" />

    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M46,43.5 L68,54 L46,64.5 Z" />
</vector>
